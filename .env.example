# Environment variables understood by Spore-Photos.
#
# Every setting can live in config/spore-photos.config.json instead; environment
# variables win over the file. Copy the lines you need into your service
# manager, container, or shell — do not commit real values.

# ── Deployment ───────────────────────────────────────────────
NODE_ENV=production
# Path to a config file other than <repo>/config/spore-photos.config.json
# SPORE_PHOTOS_CONFIG=/etc/spore-photos/config.json

# ── API server ───────────────────────────────────────────────
PORT=4051
# Only needed when the web UI is served from a different origin.
CORS_ORIGIN=
# true only when a reverse proxy you control sets X-Forwarded-* headers.
TRUST_PROXY=false
# What this server calls itself in the UI (the top bar). Empty means the
# hostname the browser is on — the right default for a fork.
SITE_NAME=

# ── Public share server ──────────────────────────────────────
# (uses its own PORT; when running separately set PORT=4052)

# ── Database (required) ──────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=spore_photos
PG_USER=spore
PG_PASSWORD=

# ── Storage ──────────────────────────────────────────────────
PICTURES_ROOT=/srv/spore-photos/library

# ── First-run setup ──────────────────────────────────────────
# Leave empty to have the server generate and log a token on first boot.
SETUP_TOKEN=

# ── Updates ──────────────────────────────────────────────────
# The release.json this install checks against. Set it here (or in
# config/spore-photos.config.json under update.sourceUrl). There is no default:
# unset means nothing is checked. Any host that serves the file works.
# UPDATE_SOURCE_URL=https://your-host/release.json