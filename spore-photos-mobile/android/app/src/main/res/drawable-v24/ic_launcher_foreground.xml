<?xml version="1.0" encoding="utf-8"?>
<!--
  The Spore-Photos brand mark, as the adaptive icon's foreground layer: the lucide
  "camera" from spore-photos-client/public/logo.svg, with its geometry unchanged.

  It is stroke art, not fill art. The previous revision filled these same paths
  (android:fillColor), which renders a solid blob rather than the outline mark the
  app uses everywhere else — logo.svg is fill="none" stroke="currentColor" — and its
  path data was an older revision of the same lucide icon, so it drew a slightly
  different camera as well.

  The viewport is the launcher's 108dp canvas, of which only the centre ~72dp is
  guaranteed to survive any launcher's mask. The mark spans 52 of those 108 units
  (48%), which keeps it comfortably inside the mask at every shape a launcher uses.

  Geometry: scale 2.3564 = 108 x 0.48 / 22, then translate by 54 - 12s on both axes.
  The mark is not centred in its own 24-unit viewBox — measured, its visual box
  including the stroke runs x 0.9-22.9, y 2.8-21.0, so it centres at (11.9, 11.9) and
  both offsets are the same expression. Centring the viewBox instead of the artwork
  leaves the camera visibly high. scripts/generate-icons.sh uses the same numbers, at
  a larger fraction because a legacy bitmap is not cropped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="25.7232"
        android:translateY="25.7232"
        android:scaleX="2.3564"
        android:scaleY="2.3564">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#066176"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#066176"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M12 13m-3 0a3 3 0 1 1 6 0a3 3 0 1 1 -6 0" />
    </group>
</vector>
