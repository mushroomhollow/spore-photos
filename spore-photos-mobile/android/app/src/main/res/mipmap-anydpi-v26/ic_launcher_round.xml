<?xml version="1.0" encoding="utf-8"?>
<!--
  See ic_launcher.xml — same layers on purpose. The adaptive-icon format is
  shape-agnostic (the launcher masks it), so a separate "round" composition would
  only be a second thing to keep in step.

  It still matters that this file exists: without it, a launcher asking for a round
  icon falls back to mipmap-*/ic_launcher_round.png, and on API 26+ that is the
  legacy square bitmap again.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
