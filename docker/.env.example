# Copy to .env and edit. This file is read twice by Compose: as variable
# substitution for compose.yaml, and as the environment for the containers.

# ── Database (required) ──────────────────────────────────────────────
# Safe characters only: letters, digits, - _ . (no $, quotes or spaces).
PG_PASSWORD=change-me-to-a-long-random-string
PG_DATABASE=spore_photos
PG_USER=spore

# ── Storage ──────────────────────────────────────────────────────────
# Host path for the photo library. Created if missing. Use an absolute path
# for real deployments (e.g. /data/photos on a Proxmox mount).
LIBRARY_PATH=./library

# ── Networking ───────────────────────────────────────────────────────
# Host port for the web UI + API.
APP_PORT=4051
# true only when a reverse proxy in front of this stack sets X-Forwarded-*
# headers (nginx, Caddy, Cloudflare Tunnel). Without it the app sees the
# proxy address as the client address and will not mark cookies Secure.
TRUST_PROXY=false

# ── Runtime ──────────────────────────────────────────────────────────
# uid:gid the app runs as inside the container. Match the owner of
# LIBRARY_PATH so uploads can be written.
PUID=1000
PGID=1000
# Set to true to chown -R the library on start (slow on a large library).
CHOWN_RECURSIVE=false

# ── Optional ─────────────────────────────────────────────────────────
# Fixed first-run setup token. Leave empty to have one generated and logged.
# SETUP_TOKEN=
# Seconds to wait for Postgres before giving up.
# DB_WAIT_TIMEOUT=120